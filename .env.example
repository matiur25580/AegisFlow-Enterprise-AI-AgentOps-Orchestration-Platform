NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/aegisflow
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Generate a unique random value with at least 32 characters. Never reuse production secrets.
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# Required to create or resolve application-managed provider secrets (32 random bytes, hex encoded).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key outside MongoDB and back it up securely; losing it makes stored credentials unrecoverable.
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters-from-a-secure-random-generator
